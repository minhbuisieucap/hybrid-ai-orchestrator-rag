# Copy this file to .env and edit values locally. Never commit .env.

# Privacy policy
# Local-only is the default. Setting it to false does NOT by itself send
# document evidence to the cloud; ALLOW_CLOUD_FALLBACK and ALLOW_CLOUD_RAG
# are separate, explicit gates.
LOCAL_ONLY=true
ALLOW_CLOUD_FALLBACK=false
# ALLOW_CLOUD_RAG=true requires ALLOW_CLOUD_FALLBACK=true.
ALLOW_CLOUD_RAG=false

# Provider selection
DEFAULT_PROVIDER=ollama
PROVIDER_PRIORITY=ollama,openai,gemini
# LOCAL_ONLY=true accepts only localhost, 127.0.0.1, or ::1 here.
# A remote Ollama endpoint is treated as an external provider.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
# Cloud models are intentionally blank. Set a model your account can use.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
REQUEST_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2

# Paths
DOCUMENTS_DIR=data/documents
STORAGE_DIR=storage

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval and fusion
DENSE_TOP_K=8
BM25_TOP_K=8
FUSED_TOP_K=5
RRF_K=60

# Evidence gates. Dense cosine similarity and BM25 scores are not comparable;
# each has its own gate. Calibrate these on your own corpus.
DENSE_MIN_SIMILARITY=0.30
BM25_MIN_SCORE=0.0
BM25_MIN_COVERAGE=0.67

# Context and conversation
MAX_CONTEXT_CHARS=6000
HISTORY_MESSAGES=6
